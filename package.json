{
    "name": "@team-affix/unilog-server",
    "version": "0.1.0",
    "description": "A server that keeps Unilog packages: an IPFS pinning service that pins a package only if it and its dependencies check with Unilog.",
    "license": "MIT",
    "author": "Team Affix",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "unilog-server": "dist/main.js"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "npm run build && bash test/e2e/user-stories.sh",
        "lint": "eslint src test",
        "format": "prettier --write src test",
        "prepublishOnly": "npm run build && npm run lint && npm test",
        "bundle": "esbuild src/main.ts --bundle --platform=node --target=node20 --outfile=release/unilog-server.cjs"
    },
    "dependencies": {
        "@team-affix/dpm": "https://github.com/team-affix/apm/releases/download/v0.2.0/team-affix-dpm-0.2.0.tgz",
        "@team-affix/unilog": "https://github.com/team-affix/unilog/releases/download/v0.3.1/team-affix-unilog-0.3.1.tgz"
    },
    "devDependencies": {
        "@eslint/js": "^9.32.0",
        "@types/node": "^22.15.30",
        "esbuild": "^0.25.12",
        "eslint": "^9.32.0",
        "prettier": "^3.6.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.39.0",
        "vitest": "^4.1.12"
    }
}
